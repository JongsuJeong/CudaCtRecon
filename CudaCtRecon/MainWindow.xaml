<Window x:Class="CudaCtRecon.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CT Reconstruction Engine" Height="500" Width="1200">
    <Grid Margin="10">
        <TextBlock Text="CT Reconstruction Engine" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top"/>

        <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="1. Original" FontWeight="Bold" HorizontalAlignment="Center"/>
                <Border BorderBrush="Gray" BorderThickness="1">
                    <Image x:Name="Image_Original" Width="250" Height="250" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="2. Ram-Lak" FontWeight="Bold" HorizontalAlignment="Center"/>
                <Border BorderBrush="Gray" BorderThickness="1">
                    <Image x:Name="Image_Filter" Width="250" Height="20" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="4">
                <TextBlock Text="3. Filtered" FontWeight="Bold" HorizontalAlignment="Center"/>
                <Border BorderBrush="Gray" BorderThickness="1">
                    <Image x:Name="Image_Filtered" Width="250" Height="250" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="6">
                <TextBlock Text="4. Reconstruction" FontWeight="Bold" HorizontalAlignment="Center"/>
                <Border BorderBrush="Gold" BorderThickness="2">
                    <Image x:Name="Image_Reconstruction" Width="250" Height="250" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="6" Margin="0,10,0,0">
                <TextBlock x:Name="Txt_SliceIndex" Text="Slice: 128" FontWeight="Bold" HorizontalAlignment="Center"/>
                <Slider x:Name="Slider_ZSlice" Minimum="0" Maximum="255" Value="128" 
            ValueChanged="Slider_ZSlice_ValueChanged" TickFrequency="1" IsSnapToTickEnabled="True"/>
            </StackPanel>

            <TextBlock Grid.Column="1" Text="▶" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="3" Text="▶" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="5" Text="▶" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>